# ─────────────────────────────────────────────────────────────
# Environment variables for local Docker Compose development
# Copy to .env and fill in real values
# ─────────────────────────────────────────────────────────────

# Database (direct connection — used for migrations)
POSTGRES_PASSWORD=integration_pass

# Redis — Sentinel HA (comma-separated host:port list, 3-node quorum)
# Set these when running with docker-compose (sentinel topology).
# Leave unset for standalone Redis (single-node dev without Sentinel).
REDIS_SENTINEL_HOSTS=redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379
REDIS_MASTER_NAME=mymaster
REDIS_PASSWORD=redis_pass

# Admin credentials (used for dashboard login)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# JWT
JWT_SECRET=change-this-in-production-use-64-char-random-string

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Webhook
WEBHOOK_SECRET=change-this-to-a-random-secret-shared-with-odoo

# ── AI Monitor (automated diagnostics) ─────────────────────────────
# The AI Monitor works out-of-the-box with a built-in rule engine (no key
# required). To additionally generate a natural-language summary via an
# OpenAI-compatible LLM, set an API key below. If unset, the monitor falls
# back to a deterministic rule-based summary.
# AI_MONITOR_API_KEY=your_openai_or_compatible_api_key
# AI_MONITOR_API_URL=https://api.openai.com/v1/chat/completions
# AI_MONITOR_MODEL=gpt-4o-mini
# Set to false to disable the scheduled 30-min analysis + alerting.
AI_MONITOR_ENABLED=true

# ── Automatic Pipeline Configuration ──────────────────────────────
# Enable/disable the automatic sync pipeline (default: true)
PIPELINE_ENABLED=true
# Minimum number of pending orders before creating a sync job (default: 1)
PIPELINE_MIN_BATCH_SIZE=1


# Root domain only — NO trailing slash, NO path segment.
# ✗ Wrong:  https://your-instance.odoo.com/api/pos/order
# ✓ Correct: https://your-instance.odoo.com
ODOO_BASE_URL=https://your-odoo-instance.com
# API key authentication (preferred — set this and leave ODOO_DB/USERNAME/PASSWORD empty)
ODOO_API_KEY=your_odoo_api_key
ODOO_DB=your_odoo_db
ODOO_USERNAME=api_user
ODOO_PASSWORD=your_odoo_password

# Oracle (fill in your instance details)
ORACLE_SOAP_WSDL_URL=https://oracle.example.com/services/v2
ORACLE_REST_BASE_URL=https://oracle.example.com/fscmRestApi/resources/11.13.18.05
ORACLE_USERNAME=oracle_api_user
ORACLE_PASSWORD=your_oracle_password
# Oracle transaction type (class "Credit Memo") used to push refunds as credit
# memos. Per-store override lives in StoreConfiguration.creditMemoTransactionType;
# this is the global default. Must match a real Credit Memo transaction type in
# your Oracle Fusion instance, e.g. "PASA CREDIT MEMO".
ORACLE_CREDIT_MEMO_TRANSACTION_TYPE=
# Apply each credit memo to the invoice it credits (a "receivable application").
# OFF by default because the exact Oracle op/endpoint differs by pod and must be
# confirmed from your WSDL. When false, memos are created on-account and finance
# applies them manually. Set the endpoint/action/namespace to match your instance,
# then flip ORACLE_CM_APPLY_ENABLED=true once verified.
ORACLE_CM_APPLY_ENABLED=false
ORACLE_CM_APPLY_SERVICE_PATH=/fscmService/CreditMemoService
ORACLE_CM_APPLY_SOAP_ACTION=
ORACLE_CM_APPLY_NAMESPACE=
ORACLE_CM_APPLY_NAMESPACE_TYPES=

# Oracle DB native connection (for direct data import from ODOO_INTEGRATION schema)
ORACLE_DB_HOST=your-oracle-db-host
ORACLE_DB_PORT=1521
ORACLE_DB_SERVICE=your-service-name.oraclevcn.com
ORACLE_DB_SCHEMA=ODOO_INTEGRATION
ORACLE_DB_USERNAME=SYS
ORACLE_DB_PASSWORD=your_oracle_db_password
ORACLE_DB_ROLE=SYSDBA
# Set to true when the Oracle server enforces Native Network Encryption (NNE) or Data
# Integrity (ORA-12660 / NJS-533). Thick mode requires Oracle Instant Client to be
# installed on the host. See https://node-oracledb.readthedocs.io/en/latest/user_guide/initialization.html
ORACLE_DB_THICK_MODE=false
# Optional: absolute path to the Oracle Instant Client shared libraries directory.
# Leave unset to let node-oracledb locate Instant Client via the system library path.
ORACLE_DB_INSTANT_CLIENT_DIR=/opt/oracle/instantclient

# ── Application database (TypeORM/Oracle) ─────────────────────────────────────
# SEPARATE from ORACLE_DB_* above (which is the Oracle Fusion ERP source).
# This is the app's own operational store, replacing Prisma/PostgreSQL. Point it
# at your APPLICATION Oracle DB — for multitenant, use the PDB service, not the
# CDB-root service, and connect as the schema/user (not SYS). This DB uses
# Native Network Encryption, so thick mode + Instant Client are required.
APP_DB_HOST=your-app-oracle-host
APP_DB_PORT=1521
APP_DB_SERVICE=pdb1.example.oraclevcn.com
APP_DB_USERNAME=NEW_INTEGRATION
APP_DB_PASSWORD=your_app_schema_password
APP_DB_SCHEMA=NEW_INTEGRATION
APP_DB_THICK_MODE=true
APP_DB_INSTANT_CLIENT_DIR=/opt/oracle/instantclient
# SYNCHRONIZE=true only for a first bootstrap of the schema; use migrations after.
APP_DB_SYNCHRONIZE=false
APP_DB_LOGGING=false
