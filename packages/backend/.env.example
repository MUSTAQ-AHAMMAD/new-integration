# Database
DATABASE_URL="******localhost:5432/integration_db"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# App
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Odoo
ODOO_BASE_URL=https://your-odoo-instance.com
ODOO_DB=your_db
ODOO_USERNAME=api_user
ODOO_PASSWORD=your_password

# Oracle REST
ORACLE_REST_BASE_URL=https://oracle-instance/fscmRestApi/resources/11.13.18.05
ORACLE_USERNAME=oracle_user
ORACLE_PASSWORD=oracle_password

# Oracle SOAP (separate base URL for SOAP services)
ORACLE_SOAP_BASE_URL=https://oracle-instance
ORACLE_SOAP_WSDL_URL=https://oracle-instance/services/v2

# VendHQ
VENDHQ_BASE_URL=https://your-outlet.vendhq.com
VENDHQ_API_TOKEN=your_vendhq_token

# JWT
JWT_SECRET=change-this-in-production-use-long-random-string

# Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@integration.com

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9464
