model VendHqOutlet {
  id          String    @id @default(cuid())
  outletId    String
  outletName  String
  currency    String    @default("AED")
  version     Int       @default(1)
  deletedAt   DateTime?
  region      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  registers VendHqRegister[]

  @@unique([outletId, region])
  @@index([region])
}

model VendHqRegister {
  id            String    @id @default(cuid())
  registerId    String
  outletId      String
  registerName  String
  cashAccount   String?
  cashAccountId Int?
  bankAccount   String?
  bankAccountId Int?
  giftAccount   String?
  giftAccountId Int?
  version       Int       @default(1)
  deletedAt     DateTime?
  region        String
  outletPk      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  outlet VendHqOutlet? @relation(fields: [outletPk], references: [id])

  @@unique([registerId, region])
  @@index([outletId])
  @@index([region])
}

model VendHqServiceProvider {
  id              String   @id @default(cuid())
  region          String
  serviceProvider String
  vendHqCustomerId String?
  isCash          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([region])
  @@index([serviceProvider])
}

model VendHqItemMeta {
  id              String    @id @default(cuid())
  requestId       Int?
  status          String?
  message         String?
  itemId          String
  sourceId        Int?
  uomCode         String?
  handle          String?
  itemType        String?
  uomName         String?
  active          Boolean   @default(true)
  name            String
  description     String?
  sku             String?
  brandId         String?
  trackInventory  Boolean   @default(false)
  retailPrice     Float?
  taxId           String?
  requestDate     DateTime?
  lastUpdateDate  DateTime?
  region          String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([itemId])
  @@index([sku])
  @@index([region])
  @@index([active])
}

// ─── Fusion Transaction Log Tables ────────────────────────────────

model FusionInvoiceHeader {
  id               String    @id @default(cuid())
  requestId        Int?
  status           String    @default("PENDING")
  message          String?
  requestDate      DateTime?
