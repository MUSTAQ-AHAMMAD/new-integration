      "type": "timeseries",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "integration_queue_waiting{queue=\"order-sync\"}", "legendFormat": "order-sync", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "integration_queue_waiting{queue=\"inventory-sync\"}", "legendFormat": "inventory-sync", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "integration_queue_waiting{queue=\"retry\"}", "legendFormat": "retry", "refId": "C" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "integration_queue_waiting{queue=\"notifications\"}", "legendFormat": "notifications", "refId": "D" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "Order Processing",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "short" },
        "overrides": []
