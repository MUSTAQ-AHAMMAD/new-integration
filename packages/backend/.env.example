# ─────────────────────────────────────────────────────────────
# Backend environment variables — copy to .env and fill in real values
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# Direct connection used for Prisma migrations and the app itself.
DATABASE_URL="******localhost:5432/integration_db"
# When running behind PgBouncer add ?pgbouncer=true&connection_limit=10
# and keep DIRECT_DATABASE_URL pointing at the raw Postgres socket for migrations.
DIRECT_DATABASE_URL="******localhost:5432/integration_db"

# ── Redis ─────────────────────────────────────────────────────
# Standalone (single-node dev):
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Sentinel HA — comment the two lines above and uncomment these when using the
# full docker-compose stack (3-node Sentinel quorum).
# REDIS_SENTINEL_HOSTS=redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379
# REDIS_MASTER_NAME=mymaster
# REDIS_PASSWORD=redis_pass

# ── App ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
LOG_LEVEL=debug
# Allowed CORS origin — set to your dashboard URL (e.g. http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# ── Webhook ───────────────────────────────────────────────────
# Shared secret used to validate inbound Odoo webhook payloads.
WEBHOOK_SECRET=change-this-to-a-random-secret-shared-with-odoo

# ── Odoo ──────────────────────────────────────────────────────
# Root domain of your Odoo instance — NO trailing slash, NO path segment.
# ✗ Wrong:  https://your-instance.odoo.com/api/pos/order
# ✓ Correct: https://your-instance.odoo.com
ODOO_BASE_URL=https://your-odoo-instance.com
# API key authentication (preferred for Odoo 16+):
#   Set ODOO_API_KEY and leave ODOO_DB / ODOO_USERNAME / ODOO_PASSWORD empty.
# Session authentication (fallback for older instances):
#   Leave ODOO_API_KEY empty and fill in the three fields below.
ODOO_API_KEY=your_odoo_api_key
ODOO_DB=your_db
ODOO_USERNAME=api_user
ODOO_PASSWORD=your_password

# ── Oracle REST / SOAP ────────────────────────────────────────
ORACLE_REST_BASE_URL=https://oracle-instance/fscmRestApi/resources/11.13.18.05
ORACLE_USERNAME=oracle_user
ORACLE_PASSWORD=oracle_password

ORACLE_SOAP_BASE_URL=https://oracle-instance
ORACLE_SOAP_WSDL_URL=https://oracle-instance/services/v2

# ── Oracle DB native connection ───────────────────────────────
# Required when using the "Import from Oracle" feature.
ORACLE_DB_HOST=your-oracle-host
ORACLE_DB_PORT=1521
ORACLE_DB_SERVICE=your-service-name.oraclevcn.com
ORACLE_DB_SCHEMA=ODOO_INTEGRATION
ORACLE_DB_USERNAME=SYS
ORACLE_DB_PASSWORD=your_oracle_db_password
# Set to SYSDBA if connecting as the SYS user
ORACLE_DB_ROLE=SYSDBA
# Set to true when the Oracle server enforces Native Network Encryption (NNE) or
# Data Integrity (ORA-12660 / NJS-533). Thick mode requires Oracle Instant Client.
ORACLE_DB_THICK_MODE=false
# Absolute path to the Oracle Instant Client shared libraries directory.
# Leave unset to let node-oracledb locate it via the system library path.
ORACLE_DB_INSTANT_CLIENT_DIR=/opt/oracle/instantclient

# ── VendHQ ────────────────────────────────────────────────────
VENDHQ_BASE_URL=https://your-outlet.vendhq.com
VENDHQ_API_TOKEN=your_vendhq_token

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=change-this-in-production-use-long-random-string
JWT_EXPIRES_IN=8h

# ── Admin credentials (used for dashboard login) ──────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=123456789

# ── Notifications ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Set SMTP_SECURE=true when using port 465 (implicit TLS); leave unset for STARTTLS (port 587)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@integration.com

# ── Monitoring ────────────────────────────────────────────────
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9464

# ── Sync behaviour ────────────────────────────────────────────
# Number of hours an order can remain in PENDING before it is flagged as stalled.
# Defaults to 6 if not set.
STALE_THRESHOLD_HOURS=6
