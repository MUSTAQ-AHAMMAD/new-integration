{
  "name": "new-integration",
  "private": true,
  "version": "0.1.0",
  "description": "Enterprise middleware integration system - Odoo to Oracle Fusion",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9.0.0 <10.0.0"
  },
  "scripts": {
    "dev": "concurrently \"pnpm --filter backend dev\" \"pnpm --filter dashboard dev\"",
    "build": "pnpm --filter backend build && pnpm --filter dashboard build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter backend db:generate",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:studio": "pnpm --filter backend db:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
