  txnSourceName    String?
  subInventory     String?
  txnUom           String?
  txnDate          DateTime?
  txnQty           Float?
  region           String
  integMode        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([region])
  @@index([itemNumber])
}

// ─── Backup / Archive Tables (read-only view) ─────────────────────

model BackupVendHqSale {
  id                String   @id @default(cuid())
  invoiceNumber     String
  /// VendHQ sale identifier / invoice number used as the Oracle sales-order reference
  saleNumber        String?
  outletName        String?
  /// VendHQ outlet id — used to look up VendHqOutlet → VendHqRegister
  outletId          String?
  registerName      String?
  saleDate          DateTime
  totalPrice        Float?
  totalTax          Float?
  totalLoyalty      Float?
  totalPriceInclTax Float?
  version           Int?
  region            String
  customerType      String?
  /// Raw JSON payload received from VendHQ (preserved for debugging / re-processing)
  rawJson           Json?
  createdAt         DateTime @default(now())

  backupLineItems BackupVendHqLineItem[]
  backupPayments  BackupVendHqPayment[]

  @@index([region])
  @@index([invoiceNumber])
  @@index([saleNumber])
  @@index([saleDate])
}

model BackupVendHqLineItem {
  id            String   @id @default(cuid())
  invoiceNumber String
  lineNumber    Int?
  itemNumber    String?
  itemName      String?
  /// VendHQ product_id (UUID) — used as the Oracle item number when present
  productId     String?
  /// Human-readable product name
  productName   String?
  quantity      Float?
  loyaltyValue  Float?
  totalPrice    Float?
  totalTax      Float?
  totalDiscount Float?
  totalLoyalty  Float?
  region        String
  saleDate      DateTime
  taxName       String?
  createdAt     DateTime @default(now())

  /// FK to parent BackupVendHqSale
  saleId String?
  sale   BackupVendHqSale? @relation(fields: [saleId], references: [id])

  @@index([region])
  @@index([invoiceNumber])
  @@index([saleDate])
  @@index([saleId])
}

model BackupVendHqPayment {
  id            String    @id @default(cuid())
  invoiceNumber String
  outletName    String?
  registerName  String?
  amount        Float?
  currency      String    @default("AED")
  paymentType   String?
  /// Normalised payment method name (mirrors VendHQ payment_type name)
  paymentMethod String?
  paymentDate   DateTime?
  deletedAt     DateTime?
  region        String
  saleDate      DateTime
  createdAt     DateTime  @default(now())

  /// FK to parent BackupVendHqSale
  saleId String?
  sale   BackupVendHqSale? @relation(fields: [saleId], references: [id])

  @@index([region])
  @@index([invoiceNumber])
  @@index([saleDate])
  @@index([saleId])
}

model BackupVendHqPromotion {
  id            String   @id @default(cuid())
  invoiceNumber String
  lineNumber    Int?
  name          String?
  amount        Float?
  region        String
  saleDate      DateTime
  createdAt     DateTime @default(now())

  @@index([region])
  @@index([invoiceNumber])
}

// ─────────────────────────────────────────────────────────────────
// COMPOSITE PRIMARY KEY: per-sale sync status tracker
// ─────────────────────────────────────────────────────────────────

enum SaleStatus {
  PENDING
  PROCESSING
  SYNCED
  FAILED
  SKIPPED
}

model SaleSyncStatus {
  saleId           String
  outletId         String
  saleDate         DateTime
  status           SaleStatus
  syncAttempts     Int        @default(0)
  lastSyncAt       DateTime?
  errorMessage     String?
  oracleInvoiceId  String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@id([saleId, outletId, saleDate])
  @@index([status])
  @@index([saleDate])
  @@index([outletId])
}

// ─────────────────────────────────────────────────────────────────
// PER-ENTITY AUDIT TABLES (Oracle call payloads)
// ─────────────────────────────────────────────────────────────────

enum ReceiptType {
  STANDARD
  MISC
  APPLY
}

model FusionInvoiceAudit {
  id               String      @id @default(cuid())
  vendhqSaleId     String
  vendhqSaleNumber String
  oracleInvoiceId  String
  invoiceNumber    String
  invoiceAmount    Decimal     @db.Decimal(15, 2)
  invoiceDate      DateTime
  requestPayload   String      @db.Text
  responsePayload  String?     @db.Text
  status           AuditStatus
  errorMessage     String?
  processingTimeMs Int
  createdAt        DateTime    @default(now())

  @@index([vendhqSaleId])
  @@index([oracleInvoiceId])
  @@index([invoiceDate])
  @@index([status])
}

model FusionReceiptAudit {
  id               String      @id @default(cuid())
  vendhqSaleId     String
  vendhqPaymentId  String
  receiptType      ReceiptType
  oracleReceiptId  String
  receiptNumber    String
  receiptAmount    Decimal     @db.Decimal(15, 2)
  paymentMethod    String
  requestPayload   String      @db.Text
  responsePayload  String?     @db.Text
  status           AuditStatus
  errorMessage     String?
  processingTimeMs Int
  createdAt        DateTime    @default(now())

  @@index([vendhqSaleId])
  @@index([oracleReceiptId])
  @@index([receiptType])
}

model FusionJournalAudit {
  id               String      @id @default(cuid())
  vendhqSaleId     String
  journalHeaderId  String
  journalName      String
  journalAmount    Decimal     @db.Decimal(15, 2)
  glDate           DateTime
  requestPayload   String      @db.Text
  responsePayload  String?     @db.Text
  status           AuditStatus
  errorMessage     String?
  processingTimeMs Int
  createdAt        DateTime    @default(now())

  @@index([vendhqSaleId])
  @@index([glDate])
}

model FusionInventoryAudit {
  id               String      @id @default(cuid())
  vendhqSaleId     String
  productId        String
  branchCode       String
  quantityChange   Decimal     @db.Decimal(15, 3)
  transactionType  String
  oracleTxnId      String
  requestPayload   String      @db.Text
  responsePayload  String?     @db.Text
  status           AuditStatus
  errorMessage     String?
  processingTimeMs Int
  createdAt        DateTime    @default(now())

  @@index([vendhqSaleId])
  @@index([productId])
  @@index([branchCode])
}

// ─────────────────────────────────────────────────────────────────
// VENDHQ FULL BACKUP TABLES
// ─────────────────────────────────────────────────────────────────

model BackupVendhqSales {
  id             String    @id @default(cuid())
  saleId         String    @unique
  saleNumber     String
  outletId       String
  outletName     String
  customerId     String?
  customerName   String?
  saleDate       DateTime
  saleDateUtc    DateTime
  totalAmount    Decimal   @db.Decimal(15, 2)
  totalTax       Decimal   @db.Decimal(15, 2)
  status         String
  rawJson        Json
  syncedToFusion Boolean   @default(false)
  fusionSyncDate DateTime?
  createdAt      DateTime  @default(now())

  lineItems BackupVendhqLineItems[]
  payments  BackupVendhqPayments[]

  @@index([saleDate])
  @@index([outletId])
  @@index([syncedToFusion])
  @@index([saleDateUtc])
}

model BackupVendhqLineItems {
  id             String  @id @default(cuid())
  saleId         String
  lineId         String
  productId      String
  productName    String
  quantity       Decimal @db.Decimal(15, 3)
  unitPrice      Decimal @db.Decimal(15, 2)
  totalPrice     Decimal @db.Decimal(15, 2)
  taxAmount      Decimal @db.Decimal(15, 2)
  discountAmount Decimal @db.Decimal(15, 2)

  sale BackupVendhqSales @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([productId])
}

model BackupVendhqPayments {
  id            String  @id @default(cuid())
  saleId        String
  paymentId     String
  paymentMethod String
  amount        Decimal @db.Decimal(15, 2)
  reference     String?
  status        String

  sale BackupVendhqSales @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([paymentMethod])
}

// ─────────────────────────────────────────────────────────────────
// OPENING BALANCE (reconciliation)
// ─────────────────────────────────────────────────────────────────

model OpeningBalance {
  id             String    @id @default(cuid())
  branchCode     String
  accountType    String
  accountCode    String
  balanceDate    DateTime
  balanceAmount  Decimal   @db.Decimal(15, 2)
  currency       String    @default("AED")
  reference      String?
  notes          String?
  reconciledWith String?
  isReconciled   Boolean   @default(false)
  reconciledAt   DateTime?
  createdAt      DateTime  @default(now())

  @@unique([branchCode, accountType, accountCode, balanceDate])
  @@index([branchCode])
  @@index([balanceDate])
  @@index([isReconciled])
}

// ─────────────────────────────────────────────────────────────────
// SERVICE PROVIDER JOURNAL MAPPING
// ─────────────────────────────────────────────────────────────────

model ServiceProviderJournalMapping {
  id              String   @id @default(cuid())
  branchCode      String
  serviceProvider String
  glAccountDebit  String
  glAccountCredit String
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([branchCode, serviceProvider])
  @@index([branchCode])
  @@index([serviceProvider])
}

// ─────────────────────────────────────────────────────────────────
// OPENCART INTEGRATION
// ─────────────────────────────────────────────────────────────────

model OpencartSite {
  id           String    @id @default(cuid())
  siteCode     String    @unique
  siteName     String
  baseUrl      String
  apiKey       String    // Store encrypted at the application layer
  branchCode   String
  isActive     Boolean   @default(true)
  lastSyncedAt DateTime?
  syncSettings Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([branchCode])
  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────
// BATCH PROCESSING JOBS (checkpoint / resume support)
// ─────────────────────────────────────────────────────────────────

model BatchJob {
  id                  String    @id @default(cuid())
  jobType             JobType
  batchId             String
  status              JobStatus
  totalRecords        Int
  processedRecords    Int       @default(0)
  successCount        Int       @default(0)
  failedCount         Int       @default(0)
  lastCheckpoint      Int       @default(0)
  checkpointData      Json?
  startedAt           DateTime?
  completedAt         DateTime?
  estimatedCompletion DateTime?
  parameters          Json
  errorSummary        Json?
  createdBy           String
  createdAt           DateTime  @default(now())

  batchItems BatchJobItem[]

  @@index([status])
  @@index([batchId])
  @@index([createdAt])
}

model BatchJobItem {
  id           String    @id @default(cuid())
  batchJobId   String
  externalId   String
  sequence     Int
  status       JobStatus
  errorMessage String?
  processedAt  DateTime?

  batchJob BatchJob @relation(fields: [batchJobId], references: [id], onDelete: Cascade)

  @@index([batchJobId])
  @@index([status])
  @@index([externalId])
}

