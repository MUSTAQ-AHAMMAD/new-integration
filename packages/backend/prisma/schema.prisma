  txnNumber        Int?
  customerTxnId    Int?
  region           String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  invoiceLines FusionInvoiceLine[]

  @@index([status])
  @@index([region])
  @@index([requestId])
}

model FusionInvoiceLine {
  id              String    @id @default(cuid())
  requestId       Int?
