# ─────────────────────────────────────────────────────────────
# Environment variables for local Docker Compose development
# Copy to .env and fill in real values
# ─────────────────────────────────────────────────────────────

# Database (direct connection — used for migrations)
POSTGRES_PASSWORD=integration_pass

# Redis — Sentinel HA (comma-separated host:port list, 3-node quorum)
# Set these when running with docker-compose (sentinel topology).
# Leave unset for standalone Redis (single-node dev without Sentinel).
REDIS_SENTINEL_HOSTS=redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379
REDIS_MASTER_NAME=mymaster
REDIS_PASSWORD=redis_pass

# JWT
JWT_SECRET=change-this-in-production-use-64-char-random-string
JWT_EXPIRES_IN=8h

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Webhook
WEBHOOK_SECRET=change-this-to-a-random-secret-shared-with-odoo

# Odoo
ODOO_BASE_URL=https://your-odoo.example.com
ODOO_DB=your_odoo_db
ODOO_USERNAME=api_user
ODOO_PASSWORD=your_odoo_password

# Oracle (fill in your instance details)
ORACLE_REST_BASE_URL=https://oracle.example.com/fscmRestApi/resources/11.13.18.05
ORACLE_SOAP_BASE_URL=https://oracle.example.com
ORACLE_SOAP_WSDL_URL=https://oracle.example.com/services/v2
ORACLE_USERNAME=oracle_api_user
ORACLE_PASSWORD=your_oracle_password

# VendHQ
VENDHQ_BASE_URL=https://your-outlet.vendhq.com
VENDHQ_API_TOKEN=your_vendhq_token

# SMTP (email notifications — leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@integration.com
