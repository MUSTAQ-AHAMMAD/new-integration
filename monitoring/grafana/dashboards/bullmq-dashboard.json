      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 20,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Orders by Sync Status",
      "type": "timeseries",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "integration_orders_by_status{status=\"SYNCED\"}", "legendFormat": "Synced", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "integration_orders_by_status{status=\"FAILED\"}", "legendFormat": "Failed", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "integration_orders_by_status{status=\"PENDING\"}", "legendFormat": "Pending", "refId": "C" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "integration_orders_by_status{status=\"PROCESSING\"}", "legendFormat": "Processing", "refId": "D" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "integration_orders_by_status{status=\"SKIPPED\"}", "legendFormat": "Skipped", "refId": "E" }
