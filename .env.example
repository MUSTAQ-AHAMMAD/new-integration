# ─────────────────────────────────────────────────────────────
# Environment variables for local Docker Compose development
# Copy to .env and fill in real values
# ─────────────────────────────────────────────────────────────

# Database (direct connection — used for migrations)
POSTGRES_PASSWORD=integration_pass

# Redis — Sentinel HA (comma-separated host:port list, 3-node quorum)
# Set these when running with docker-compose (sentinel topology).
# Leave unset for standalone Redis (single-node dev without Sentinel).
REDIS_SENTINEL_HOSTS=redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379
REDIS_MASTER_NAME=mymaster
REDIS_PASSWORD=redis_pass

# Admin credentials (used for dashboard login)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# JWT
JWT_SECRET=change-this-in-production-use-64-char-random-string

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Webhook
WEBHOOK_SECRET=change-this-to-a-random-secret-shared-with-odoo

# ── Automatic Pipeline Configuration ──────────────────────────────
# Enable/disable the automatic sync pipeline (default: true)
PIPELINE_ENABLED=true
# Minimum number of pending orders before creating a sync job (default: 1)
PIPELINE_MIN_BATCH_SIZE=1


# Root domain only — NO trailing slash, NO path segment.
# ✗ Wrong:  https://your-instance.odoo.com/api/pos/order
# ✓ Correct: https://your-instance.odoo.com
ODOO_BASE_URL=https://your-odoo-instance.com
# API key authentication (preferred — set this and leave ODOO_DB/USERNAME/PASSWORD empty)
ODOO_API_KEY=your_odoo_api_key
ODOO_DB=your_odoo_db
ODOO_USERNAME=api_user
ODOO_PASSWORD=your_odoo_password

# Oracle (fill in your instance details)
ORACLE_SOAP_WSDL_URL=https://oracle.example.com/services/v2
ORACLE_REST_BASE_URL=https://oracle.example.com/fscmRestApi/resources/11.13.18.05
ORACLE_USERNAME=oracle_api_user
ORACLE_PASSWORD=your_oracle_password

# Oracle DB native connection (for direct data import from ODOO_INTEGRATION schema)
ORACLE_DB_HOST=your-oracle-db-host
ORACLE_DB_PORT=1521
ORACLE_DB_SERVICE=your-service-name.oraclevcn.com
ORACLE_DB_SCHEMA=ODOO_INTEGRATION
ORACLE_DB_USERNAME=SYS
ORACLE_DB_PASSWORD=your_oracle_db_password
ORACLE_DB_ROLE=SYSDBA
# Set to true when the Oracle server enforces Native Network Encryption (NNE) or Data
# Integrity (ORA-12660 / NJS-533). Thick mode requires Oracle Instant Client to be
# installed on the host. See https://node-oracledb.readthedocs.io/en/latest/user_guide/initialization.html
ORACLE_DB_THICK_MODE=false
# Optional: absolute path to the Oracle Instant Client shared libraries directory.
# Leave unset to let node-oracledb locate Instant Client via the system library path.
ORACLE_DB_INSTANT_CLIENT_DIR=/opt/oracle/instantclient
