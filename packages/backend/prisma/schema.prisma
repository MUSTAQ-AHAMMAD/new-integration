generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model SyncJob {
  id               String    @id @default(cuid())
  jobType          JobType
  scopeType        ScopeType
  scopeValue       Json
  status           JobStatus @default(PENDING)
  totalRecords     Int       @default(0)
  processedRecords Int       @default(0)
  successCount     Int       @default(0)
  failedCount      Int       @default(0)
  skippedCount     Int       @default(0)
  retryCount       Int       @default(0)
  maxRetries       Int       @default(3)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  startedAt        DateTime?
  completedAt      DateTime?
  createdBy        String    @default("SYSTEM")
  errorMessage     String?
  errorDetails     Json?

  @@index([status])
  @@index([jobType])
  @@index([createdAt])
}

enum JobType {
  ORDER_SYNC
  INVENTORY_SYNC
  PAYMENT_SYNC
  CONFIG_SYNC
  REFUND_SYNC
}

enum ScopeType {
  SINGLE_ORDER
  DATE_RANGE
  BRANCH
  BRANCH_DATE_RANGE
  ALL
  FAILED_ONLY
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
  CANCELLED
}

model SyncControl {
  id          String   @id @default(cuid())
  serviceName String   @unique
  displayName String
  description String?
  enabled     Boolean  @default(true)
  isRunning   Boolean  @default(false)
  lastRunAt   DateTime?
  lastStatus  String?
  runCount    Int      @default(0)
  errorCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
  @@index([serviceName])
}

model OrderSyncQueue {
  id                     String     @id @default(cuid())
  odooOrderId            String
  odooOrderNumber        String
  branchCode             String
  branchName             String?
  /// Region identifier (e.g. "AE", "KW") from the OdooCredential that fetched this order.
  /// Populated during ingest so the processor can look up FusionSalesMetadata without
  /// relying solely on the numeric branchCode.
  region                 String?
  /// FK to BackupOdooOrder.id — populated when the order was fetched via the Odoo
  /// backup path. Lets the processor retrieve the full raw backup for transformation.
  odooBackupOrderId      String?
  orderDate              DateTime
  orderDateUtc           DateTime
  originalTimezone       String
  customerName           String?
  customerEmail          String?
  totalAmount            Decimal    @db.Decimal(15, 2)
  currency               String     @default("AED")
  status                 SyncStatus @default(PENDING)
  validationErrors       Json?
  syncAttempts           Int        @default(0)
  lastSyncAt             DateTime?
  isPaid                 Boolean    @default(false)
  isCancelled            Boolean    @default(false)
  isRefund               Boolean    @default(false)
  refundReferenceId      String?
  oracleInvoiceNumber    String?
  oracleCreditMemoNumber String?
  negativeInventoryFlag  Boolean    @default(false)
  negativeInventoryItems Json?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  failedTransactions FailedTransaction[]

  @@unique([odooOrderId, branchCode])
  @@index([status])
  @@index([branchCode])
  @@index([region])
  @@index([orderDate])
  @@index([orderDateUtc])
  @@index([isPaid])
  @@index([isRefund])
}

enum SyncStatus {
  PENDING
  VALIDATED
  PROCESSING
  SYNCED
  FAILED
  SKIPPED
  QUEUED_FOR_RETRY
  NEGATIVE_INVENTORY_HOLD
}

model AuditLog {
  id                   String         @id @default(uuid())
  idempotencyKey       String         @unique
  externalId           String
  externalSystem       String
  targetSystem         String
  operation            AuditOperation
  status               AuditStatus
  requestPayload       Json
  responsePayload      Json?
  oracleResponseId     String?
  errorMessage         String?
  errorCode            String?
  processingDurationMs Int
  attempts             Int            @default(1)
  createdAt            DateTime       @default(now())
  syncDate             DateTime       @map("sync_date")

  @@index([externalId])
  @@index([idempotencyKey])
  @@index([status])
  @@index([syncDate])
  @@index([createdAt])
  @@index([oracleResponseId])
}

enum AuditOperation {
  CREATE_INVOICE
  CREATE_RECEIPT
  CREATE_CREDIT_MEMO
  CREATE_JOURNAL
  SYNC_INVENTORY
  UPDATE_CONFIG
}

enum AuditStatus {
  SUCCESS
  FAILED
  RETRY
  SKIPPED
  DUPLICATE
}

model PaymentMethodMapping {
  id                      String   @id @default(cuid())
  sourceSystem            String
  sourcePaymentName       String
  oracleReceiptMethodId   BigInt
  oracleReceiptMethodName String
  oracleBankAccountId     BigInt?
  isActive                Boolean  @default(true)
  requiresApproval        Boolean  @default(false)
  approvedBy              String?
  approvedAt              DateTime?
  rejectionReason         String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([sourceSystem, sourcePaymentName])
  @@index([sourcePaymentName])
  @@index([isActive])
  @@index([requiresApproval])
}

model RefundTracking {
  id                     String     @id @default(cuid())
  originalOrderId        String
  originalOrderNumber    String
  originalInvoiceNumber  String?
  refundOrderId          String     @unique
  refundOrderNumber      String
  refundAmount           Decimal    @db.Decimal(15, 2)
  refundReason           String
  refundDate             DateTime
  oracleCreditMemoNumber String
  creditMemoStatus       SyncStatus @default(PENDING)
  syncedAt               DateTime?
  failureReason          String?
  isReconciled           Boolean    @default(false)
  reconcileNote          String?
  reconciledAt           DateTime?
  reconciledBy           String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  @@index([originalOrderId])
  @@index([originalInvoiceNumber])
  @@index([refundOrderId])
  @@index([creditMemoStatus])
  @@index([isReconciled])
}

model StoreConfiguration {
  id                    String           @id @default(cuid())
  branchCode            String           @unique
  branchName            String
  odooBranchId          BigInt
  oracleOperatingUnitId BigInt
  oracleBusinessUnit    String
  billToSiteName        String
  billToLocation        String?
  bankAccountName       String
  cashAccountName       String
  paymentTermsName      String
  taxClassificationCode String?
  transactionSource     String           @default("Manual")
  transactionType       String           @default("PASA CONSULTING SALE")
  invoiceCurrencyCode   String           @default("AED")
  /// Region identifier (e.g. "AE", "KW", "OM") — matches OdooCredential.region
  /// and is used to link a store to its regional Oracle configuration.
  region                String?
  /// Oracle Fusion numeric bank account ID for card/non-cash receipts.
  /// Mirrors VendHqRegister.bankAccountId — must be populated for receipt creation.
  bankAccountId         Int?
  /// Oracle Fusion numeric cash account ID for cash receipts.
  /// Mirrors VendHqRegister.cashAccountId — must be populated for receipt creation.
  cashAccountId         Int?

  // Service provider → GL account mapping (JSON)
  serviceProviderJournalMapping Json?

  // Per-item quantity decimal precision rules
  txnQuantityDecimals   Json?

  // Control flags
  isActive                        Boolean  @default(true)
  allowNegativeInventory          Boolean  @default(true)
  autoCreateMissingPaymentMethods Boolean  @default(false)

  lastValidatedAt       DateTime?
  validationStatus      ValidationStatus @default(PENDING)
  validationErrors      Json?
  version               Int              @default(1)
  createdBy             String
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([branchCode])
  @@index([validationStatus])
  @@index([isActive])
  @@index([region])
  @@index([odooBranchId])
}

enum ValidationStatus {
  PENDING
  VALIDATED
  INVALID
  PARTIAL
}

model FailedTransaction {
  id               String   @id @default(cuid())
  orderSyncQueueId String?
  originalPayload  Json
  errorType        ErrorType
  errorMessage     String
  errorStack       String?
  errorCode        String?
  retryCount       Int      @default(0)
  maxRetries       Int      @default(3)
  nextRetryAt      DateTime?
  isResolved       Boolean  @default(false)
  resolvedBy       String?
  resolvedAt       DateTime?
  resolutionNote   String?
  createdAt        DateTime @default(now())

  orderSyncQueue OrderSyncQueue? @relation(fields: [orderSyncQueueId], references: [id])

  @@index([errorType])
  @@index([isResolved])
  @@index([nextRetryAt])
  @@index([createdAt])
}

enum ErrorType {
  VALIDATION_ERROR
  NETWORK_ERROR
  TIMEOUT
  MAPPING_ERROR
  AUTHENTICATION_ERROR
  RATE_LIMIT_ERROR
  DUPLICATE_ERROR
  INVENTORY_ERROR
  PAYMENT_METHOD_ERROR
  CONFIGURATION_ERROR
  UNKNOWN_ERROR
}

model InventorySyncTracker {
  id                         String                   @id @default(cuid())
  productId                  String
  productSku                 String
  productName                String?
  branchCode                 String
  transactionDate            DateTime
  transactionType            InventoryTransactionType
  previousQuantity           Decimal                  @db.Decimal(15, 3)
  newQuantity                Decimal                  @db.Decimal(15, 3)
  quantityChange             Decimal                  @db.Decimal(15, 3)
  syncStatus                 SyncStatus               @default(PENDING)
  isNegativeInventory        Boolean                  @default(false)
  negativeInventoryAlertSent Boolean                  @default(false)
  orderReferenceId           String?
  oracleTransactionId        String?
  reviewedAt                 DateTime?
  reviewedBy                 String?
  reviewNote                 String?
  createdAt                  DateTime                 @default(now())
  syncedAt                   DateTime?

  @@unique([productId, branchCode, transactionDate, transactionType])
  @@index([productId])
  @@index([branchCode])
  @@index([isNegativeInventory])
  @@index([syncStatus])
  @@index([transactionDate])
  @@index([reviewedAt])
}

enum InventoryTransactionType {
  SALE
  RETURN
  ADJUSTMENT
  RECEIPT
  TRANSFER
}

model IntegrationHealthCheck {
  id                  String       @id @default(cuid())
  serviceName         ServiceName
  status              HealthStatus
  responseTimeMs      Int
  lastSuccessAt       DateTime
  lastFailureAt       DateTime?
  failureReason       String?
  consecutiveFailures Int          @default(0)
  createdAt           DateTime     @default(now())

  @@index([serviceName])
  @@index([status])
  @@index([createdAt])
}

enum ServiceName {
  ODOO_API
  ORACLE_SOAP
  ORACLE_REST
  REDIS
  DATABASE
  WEBHOOK
}

enum HealthStatus {
  HEALTHY
  DEGRADED
  UNHEALTHY
  UNKNOWN
}

model NotificationRecipient {
  id                     String           @id @default(cuid())
  email                  String           @unique
  name                   String
  role                   NotificationRole

  // Alert preferences
  receiveErrorAlerts     Boolean  @default(true)
  receiveDailyReports    Boolean  @default(false)
  receiveInventoryAlerts Boolean  @default(false)
  receivePaymentAlerts   Boolean  @default(false)
  receiveConfigAlerts    Boolean  @default(true)

  // Escalation
  escalationLevel        Int      @default(1)
  backupRecipientId      String?

  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())

  @@index([role])
  @@index([isActive])
}

enum NotificationRole {
  ADMIN
  FINANCE
  INVENTORY_MANAGER
  IT_SUPPORT
  STORE_MANAGER
}

model AlertLog {
  id                String        @id @default(cuid())
  alertType         AlertType
  severity          AlertSeverity
  title             String
  message           String
  relatedEntityId   String?
  relatedEntityType String?
  isResolved        Boolean       @default(false)
  resolvedAt        DateTime?
  resolvedBy        String?
  createdAt         DateTime      @default(now())

  @@index([alertType])
  @@index([severity])
  @@index([isResolved])
  @@index([createdAt])
}

enum AlertType {
  PAYMENT_METHOD_DISCOVERED
  NEGATIVE_INVENTORY
  STORE_CONFIG_INVALID
  SYNC_FAILURE
  CONNECTION_LOST
  DUPLICATE_DETECTED
  REFUND_DETECTED
  SYNC_STALLED
  ORACLE_CONNECTION_FAILED
  ORACLE_PERFORMANCE_DEGRADED
  ORACLE_CONNECTION_RECOVERED
}

enum AlertSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

model WebhookEvent {
  id               String     @id @default(cuid())
  eventType        String
  sourceSystem     String     @default("ODOO")
  payload          Json
  receivedAt       DateTime   @default(now())
  processedAt      DateTime?
  processingStatus SyncStatus @default(PENDING)
  processingError  String?

  @@index([eventType])
  @@index([processingStatus])
  @@index([receivedAt])
}

// ─────────────────────────────────────────────────────────────────
// ORACLE INTEGRATION TABLES (ported from ODOO_INTEGRATION schema)
// ─────────────────────────────────────────────────────────────────

model FusionCredential {
  id         String   @id @default(cuid())
  hostName   String   @unique
  server     String
  username   String
  password   String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active])
}

model VendHqCredential {
  id                String    @id @default(cuid())
  domainName        String    @unique
  personalToken     String
  active            Boolean   @default(true)
  region            String
  fusionOrgCode     String?
  timezoneOffset    Float     @default(0)
  currency          String    @default("AED")
  fusionTaxCode     String?
  businessStartDate DateTime?
  /// VendHQ `version` watermark — used as `after` param for incremental fetch
  lastSyncVersion   Int       @default(0)
  /// Timestamp of the last successful backup run for this credential
  lastSyncAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([region])
  @@index([active])
}

model OutletIntegrationConfig {
  id         String   @id @default(cuid())
  outletName String   @unique
  integMode  String
  region     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([region])
  @@index([integMode])
}

model FusionBusinessUnitMap {
  id               String   @id @default(cuid())
  businessUnitId   BigInt
  businessUnitName String
  region           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([businessUnitId, region])
  @@index([region])
}

model FusionReceiptMethod {
  id                  String   @id @default(cuid())
  receiptMethodId     BigInt
  receiptMethodName   String
  receiptIsCash       Boolean  @default(false)
  receiptBankCharge   Float    @default(0)
  receiptMethodTax    Float    @default(0)
  region              String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([receiptMethodName, region])
  @@index([region])
  @@index([receiptMethodName])
}

model FusionSalesMetadata {
  id                   String   @id @default(cuid())
  billToName           String   @unique
  billToAccount        BigInt
  siteNumber           String?
  businessUnit         String
  txnSource            String
  txnType              String
  rateIsCorporate      Boolean  @default(false)
  recActivityNameBank  String?
  subinventory         String?
  integrationSource    String
  distributionAccId    BigInt?
  recActivityNameCash  String?
  region               String
  customerType         String
  costCenterCode       String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([region])
  @@index([customerType])
}

model ServiceProviderJournalMeta {
  id                String   @id @default(cuid())
  region            String
  ledgerId          BigInt
  taxGroupId        BigInt?
  chartOfAccountsId BigInt
  serviceProvider   String   @unique
  creditDebit       String?
  costIssue         String?
  costRma           String?
  company           String?
  account           String?
  department        String?
  productCategory   String?
  interCompany      String?
  futUsed           String?
  extraSegment1     String?
  extraSegment2     String?
  extraSegment3     String?
  jeCategory        String?
  jeSource          String?
  isCash            Boolean  @default(false)
  summaryFlag       Boolean  @default(false)
  fixedFreightCharge Float   @default(0)
  bankChargeRate     Float   @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([region])
  @@index([serviceProvider])
}

model SalesIntegrationStatus {
  id         String   @id @default(cuid())
  region     String
  integMode  String
  status     String
  updatedAt  DateTime @updatedAt

  @@unique([region, integMode])
  @@index([region])
  @@index([status])
}

model VendHqDiscountItem {
  id               String   @id @default(cuid())
  discountItemId   String
  region           String
  createdAt        DateTime @default(now())

  @@unique([discountItemId, region])
  @@index([region])
}

model VendHqTaxMeta {
  id          String   @id @default(cuid())
  taxId       String
  taxName     String
  version     BigInt   @default(1)
  fusionName  String?
  region      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([taxId, region])
  @@index([region])
}

model VendHqOutlet {
  id          String    @id @default(cuid())
  outletId    String
  outletName  String
  currency    String    @default("AED")
  version     BigInt    @default(1)
  deletedAt   DateTime?
  region      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  registers VendHqRegister[]

  @@unique([outletId, region])
  @@index([region])
}

model VendHqRegister {
  id            String    @id @default(cuid())
  registerId    String
  outletId      String
  registerName  String
  cashAccount   String?
  cashAccountId BigInt?
  bankAccount   String?
  bankAccountId BigInt?
  giftAccount   String?
  giftAccountId BigInt?
  version       BigInt    @default(1)
  deletedAt     DateTime?
  region        String
  outletPk      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  outlet VendHqOutlet? @relation(fields: [outletPk], references: [id])

  @@unique([registerId, region])
  @@index([outletId])
  @@index([region])
}

model VendHqServiceProvider {
  id              String   @id @default(cuid())
  region          String
  serviceProvider String   @unique
  vendHqCustomerId String?
  isCash          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([region])
  @@index([serviceProvider])
}

model VendHqItemMeta {
  id              String    @id @default(cuid())
  requestId       Int?
  status          String?
  message         String?
  itemId          String
  sourceId        Int?
  uomCode         String?
  handle          String?
  itemType        String?
  uomName         String?
  active          Boolean   @default(true)
  name            String
  description     String?
  sku             String?
  brandId         String?
  trackInventory  Boolean   @default(false)
  retailPrice     Float?
  taxId           String?
  requestDate     DateTime?
  lastUpdateDate  DateTime?
  region          String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([itemId])
  @@index([sku])
  @@index([region])
  @@index([active])
}

// ─── Fusion Transaction Log Tables ────────────────────────────────

model FusionInvoiceHeader {
  id               String    @id @default(cuid())
  requestId        Int?
  status           String    @default("PENDING")
  message          String?
  requestDate      DateTime?
  billToCustName   String?
  billToLocation   String?
  billToAccNumber  BigInt?
  businessUnit     String?
  paymentTermsName String?
  txnSource        String?
  txnType          String?
  txnDate          DateTime?
  glDate           DateTime?
  currencyCode     String    @default("AED")
  txnNumber        Int?
  customerTxnId    Int?
  region           String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  invoiceLines FusionInvoiceLine[]

  @@index([status])
  @@index([region])
  @@index([requestId])
}

model FusionInvoiceLine {
  id              String    @id @default(cuid())
  requestId       Int?
  status          String    @default("PENDING")
  message         String?
  requestDate     DateTime?
  invoiceNumber   String?
  lineNumber      Int?
  itemNumber      String?
  description     String?
  uom             String?
  quantity        Float?
  currencyCode    String    @default("AED")
  taxCode         String?
  version         Int       @default(1)
  salesOrder      String?
  salesOrderLine  Int?
  region          String
  headerId        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  header FusionInvoiceHeader? @relation(fields: [headerId], references: [id])

  @@index([status])
  @@index([region])
  @@index([invoiceNumber])
}

model FusionStandardReceipt {
  id                    String    @id @default(cuid())
  requestId             Int?
  status                String    @default("PENDING")
  message               String?
  requestDate           DateTime?
  currencyCode          String    @default("AED")
  receiptDate           DateTime?
  glDate                DateTime?
  exchangeDate          DateTime?
  exchangeRateType      String?
  receiptMethodId       BigInt?
  receiptNumber         String?
  remittanceBankAccId   String?
  depositDate           DateTime?
  customerId            Int?
  orgId                 Int?
  region                String
  integMode             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status])
  @@index([region])
  @@index([receiptNumber])
}

model FusionMiscReceipt {
  id                  String    @id @default(cuid())
  requestId           Int?
  status              String    @default("PENDING")
  message             String?
  requestDate         DateTime?
  currencyCode        String    @default("AED")
  glDate              DateTime?
  exchangeDate        DateTime?
  exchangeRateType    String?
  receiptMethodName   String?
  receiptNumber       String?
  bankAccNumber       String?
  recActivityName     String?
  receiptDate         DateTime?
  region              String
  integMode           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
  @@index([region])
  @@index([receiptNumber])
}

model FusionApplyReceipt {
  id              String    @id @default(cuid())
  requestId       Int?
  status          String    @default("PENDING")
  message         String?
  requestDate     DateTime?
  accountingDate  DateTime?
  applicationDate DateTime?
  txnNumber       String?
  receiptNumber   String?
  currencyCode    String    @default("AED")
  region          String
  integMode       String?
  txnSource       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([region])
  @@index([receiptNumber])
}

model FusionJournalHeader {
  id                         String    @id @default(cuid())
  requestId                  Int?
  status                     String    @default("PENDING")
  message                    String?
  requestDate                DateTime?
  region                     String
  jeHeaderId                 Int?
  ledgerId                   BigInt?
  batchName                  String?
  batchDescription           String?
  accountingPeriodName       String?
  userSourceName             String?
  userCategoryName           String?
  errorToSuspenseFlag        Boolean   @default(false)
  summaryFlag                Boolean   @default(false)
  accountingDate             DateTime?
  importDescriptiveFlexField String?
  txnNumber                  Int?
  integMode                  String?
  customerType               String?
  cashCredit                 String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  journalLines FusionJournalLine[]

  @@index([status])
  @@index([region])
  @@index([ledgerId])
}

model FusionJournalLine {
  id                       String    @id @default(cuid())
  requestId                Int?
  status                   String    @default("PENDING")
  message                  String?
  requestDate              DateTime?
  region                   String
  jeHeaderId               Int?
  jeLineNum                Int?
  ledgerId                 BigInt?
  groupId                  Int?
  chartOfAccountsId        BigInt?
  enteredCrAmount          Float?
  accountedCr              Float?
  enteredDrAmount          Float?
  accountedDr              Float?
  currencyConversionRate   Float?
  periodName               String?
  accountingPeriodName     String?
  userJeSourceName         String?
  userJeCategoryName       String?
  segment1                 String?
  segment2                 String?
  segment3                 String?
  segment4                 String?
  segment5                 String?
  segment6                 String?
  segment7                 String?
  segment8                 String?
  segment9                 String?
  segment10                String?
  currencyCode             String    @default("AED")
  taxCode                  String?
  recordType               String?
  accountingDate           DateTime?
  transactionDate          DateTime?
  salesOrder               String?
  txnNumber                Int?
  customerType             String?
  cashCredit               String?
  headerId                 String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  header FusionJournalHeader? @relation(fields: [headerId], references: [id])

  @@index([status])
  @@index([region])
  @@index([jeHeaderId])
}

model FusionInvTxn {
  id               String    @id @default(cuid())
  requestId        Int?
  status           String    @default("PENDING")
  message          String?
  requestDate      DateTime?
  organizationName String?
  itemNumber       String?
  txnSourceName    String?
  subInventory     String?
  txnUom           String?
  txnDate          DateTime?
  txnQty           Float?
  region           String
  integMode        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([region])
  @@index([itemNumber])
}

// ─── Backup / Archive Tables (read-only view) ─────────────────────

model BackupVendHqSale {
  id                String    @id @default(cuid())
  invoiceNumber     String
  /// VendHQ sale identifier / invoice number used as the Oracle sales-order reference
  saleNumber        String?
  outletName        String?
  /// VendHQ outlet id — used to look up VendHqOutlet → VendHqRegister
  outletId          String?
  registerName      String?
  saleDate          DateTime
  totalPrice        Float?
  totalTax          Float?
  totalLoyalty      Float?
  totalPriceInclTax Float?
  version           Int?
  region            String
  customerType      String?
  /// Raw JSON payload received from VendHQ (preserved for debugging / re-processing)
  rawJson           Json?
  createdAt         DateTime  @default(now())

  /// Whether this sale has been successfully pushed to Oracle Fusion
  fusionSynced      Boolean   @default(false)
  /// Timestamp of the last successful Oracle Fusion push
  fusionSyncAt      DateTime?
  /// Error message from the last failed Oracle Fusion push attempt
  fusionSyncError   String?

  backupLineItems BackupVendHqLineItem[]
  backupPayments  BackupVendHqPayment[]

  @@unique([invoiceNumber, region])
  @@index([region])
  @@index([invoiceNumber])
  @@index([saleNumber])
  @@index([saleDate])
  @@index([fusionSynced])
}

model BackupVendHqLineItem {
  id            String   @id @default(cuid())
  invoiceNumber String
  lineNumber    Int?
  itemNumber    String?
  itemName      String?
  /// VendHQ product_id (UUID) — used as the Oracle item number when present
  productId     String?
  /// Human-readable product name
  productName   String?
  quantity      Float?
  loyaltyValue  Float?
  totalPrice    Float?
  totalTax      Float?
  totalDiscount Float?
  totalLoyalty  Float?
  region        String
  saleDate      DateTime
  taxName       String?
  createdAt     DateTime @default(now())

  /// FK to parent BackupVendHqSale
  saleId String?
  sale   BackupVendHqSale? @relation(fields: [saleId], references: [id])

  @@index([region])
  @@index([invoiceNumber])
  @@index([saleDate])
  @@index([saleId])
}

model BackupVendHqPayment {
  id            String    @id @default(cuid())
  invoiceNumber String
  outletName    String?
  registerName  String?
  amount        Float?
  currency      String    @default("AED")
  paymentType   String?
  /// Normalised payment method name (mirrors VendHQ payment_type name)
  paymentMethod String?
  paymentDate   DateTime?
  deletedAt     DateTime?
  region        String
  saleDate      DateTime
  createdAt     DateTime  @default(now())

  /// FK to parent BackupVendHqSale
  saleId String?
  sale   BackupVendHqSale? @relation(fields: [saleId], references: [id])

  @@index([region])
  @@index([invoiceNumber])
  @@index([saleDate])
  @@index([saleId])
}

model BackupVendHqPromotion {
  id            String   @id @default(cuid())
  invoiceNumber String
  lineNumber    Int?
  name          String?
  amount        Float?
  region        String
  saleDate      DateTime
  createdAt     DateTime @default(now())

  @@index([region])
  @@index([invoiceNumber])
}

// ─────────────────────────────────────────────────────────────────
// COMPOSITE PRIMARY KEY: per-sale sync status tracker
// ─────────────────────────────────────────────────────────────────

enum SaleStatus {
  PENDING
  PROCESSING
  SYNCED
  FAILED
  SKIPPED
}

model SaleSyncStatus {
  saleId           String
  outletId         String
  saleDate         DateTime
  status           SaleStatus
  syncAttempts     Int        @default(0)
  lastSyncAt       DateTime?
  errorMessage     String?
  oracleInvoiceId  String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@id([saleId, outletId, saleDate])
  @@index([status])
  @@index([saleDate])
  @@index([outletId])
}

// ─────────────────────────────────────────────────────────────────
// PER-ENTITY AUDIT TABLES (Oracle call payloads)
// ─────────────────────────────────────────────────────────────────

enum ReceiptType {
  STANDARD
  MISC
  APPLY
}

model FusionInvoiceAudit {
  id               String      @id @default(cuid())
  vendhqSaleId     String
  vendhqSaleNumber String
  oracleInvoiceId  String
  invoiceNumber    String
  invoiceAmount    Decimal     @db.Decimal(15, 2)
  invoiceDate      DateTime
  requestPayload   String      @db.Text
  responsePayload  String?     @db.Text
  status           AuditStatus
  errorMessage     String?
  processingTimeMs Int
  createdAt        DateTime    @default(now())

  @@index([vendhqSaleId])
  @@index([oracleInvoiceId])
  @@index([invoiceDate])
  @@index([status])
}

model FusionReceiptAudit {
  id               String      @id @default(cuid())
  vendhqSaleId     String
  vendhqPaymentId  String
  receiptType      ReceiptType
  oracleReceiptId  String
  receiptNumber    String
  receiptAmount    Decimal     @db.Decimal(15, 2)
  paymentMethod    String
  requestPayload   String      @db.Text
  responsePayload  String?     @db.Text
  status           AuditStatus
  errorMessage     String?
  processingTimeMs Int
  createdAt        DateTime    @default(now())

  @@index([vendhqSaleId])
  @@index([oracleReceiptId])
  @@index([receiptType])
}

model FusionJournalAudit {
  id               String      @id @default(cuid())
  vendhqSaleId     String
  journalHeaderId  String
  journalName      String
  journalAmount    Decimal     @db.Decimal(15, 2)
  glDate           DateTime
  requestPayload   String      @db.Text
  responsePayload  String?     @db.Text
  status           AuditStatus
  errorMessage     String?
  processingTimeMs Int
  createdAt        DateTime    @default(now())

  @@index([vendhqSaleId])
  @@index([glDate])
}

model FusionInventoryAudit {
  id               String      @id @default(cuid())
  vendhqSaleId     String
  productId        String
  branchCode       String
  quantityChange   Decimal     @db.Decimal(15, 3)
  transactionType  String
  oracleTxnId      String
  requestPayload   String      @db.Text
  responsePayload  String?     @db.Text
  status           AuditStatus
  errorMessage     String?
  processingTimeMs Int
  createdAt        DateTime    @default(now())

  @@index([vendhqSaleId])
  @@index([productId])
  @@index([branchCode])
}

// ─────────────────────────────────────────────────────────────────
