  @@index([receiptMethodName])
}

model FusionSalesMetadata {
  id                   String   @id @default(cuid())
  billToName           String
  billToAccount        Int
  siteNumber           String?
  businessUnit         String
  txnSource            String
  txnType              String
  rateIsCorporate      Boolean  @default(false)
  recActivityNameBank  String?
  subinventory         String?
  integrationSource    String
  distributionAccId    Int?
  recActivityNameCash  String?
  region               String
  customerType         String
  costCenterCode       String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([region])
  @@index([customerType])
}

model ServiceProviderJournalMeta {
  id                String   @id @default(cuid())
  region            String
  ledgerId          Int
  taxGroupId        Int?
  chartOfAccountsId Int
  serviceProvider   String
  creditDebit       String?
  costIssue         String?
  costRma           String?
  company           String?
  account           String?
  department        String?
