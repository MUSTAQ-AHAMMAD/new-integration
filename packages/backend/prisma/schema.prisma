// ─────────────────────────────────────────────────────────────────
// BATCH PROCESSING JOBS (checkpoint / resume support)
// ─────────────────────────────────────────────────────────────────

model BatchJob {
  id                  String    @id @default(cuid())
  jobType             JobType
  batchId             String
  status              JobStatus
  totalRecords        Int
  processedRecords    Int       @default(0)
  successCount        Int       @default(0)
  failedCount         Int       @default(0)
  lastCheckpoint      Int       @default(0)
  checkpointData      Json?
  startedAt           DateTime?
  completedAt         DateTime?
  estimatedCompletion DateTime?
  parameters          Json
  errorSummary        Json?
  createdBy           String
  createdAt           DateTime  @default(now())

  batchItems BatchJobItem[]

  @@index([status])
  @@index([batchId])
  @@index([createdAt])
}

model BatchJobItem {
  id           String    @id @default(cuid())
  batchJobId   String
  externalId   String
  sequence     Int
  status       JobStatus
  errorMessage String?
  processedAt  DateTime?

  batchJob BatchJob @relation(fields: [batchJobId], references: [id], onDelete: Cascade)

  @@index([batchJobId])
  @@index([status])
  @@index([externalId])
}

// ─────────────────────────────────────────────────────────────────
// API ENDPOINT CONFIGURATION
// Stores all Oracle Fusion and VendHQ API endpoint paths extracted
// from the Java middleware (integration-Oracle) so they can be
// inspected and updated from the dashboard without redeploying.
// ─────────────────────────────────────────────────────────────────

model ApiEndpointConfig {
  id          String   @id @default(cuid())
  /// Which external system this endpoint belongs to: FUSION or VENDHQ
  service     String
  /// Human-readable name, e.g. "Inventory Items"
  name        String   @unique
  /// The URL path, e.g. "/fscmRestApi/resources/11.13.17.11/items"
  path        String
  /// HTTP method: GET, POST, PUT, PATCH, DELETE
  method      String   @default("GET")
  /// Short description of what the endpoint does
  description String?
  /// API version string, e.g. "11.13.17.11" for Fusion, "2.0" for VendHQ
  apiVersion  String?
  /// Optional region override; null means endpoint applies to all regions
  region      String?
  /// Whether this endpoint configuration is active
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([service])
  @@index([isActive])
  @@index([region])
}

// ─── IBQ (Odoo POS) Backup Tables ────────────────────────────────

/// Stores API credentials for each IBQ (Odoo POS) instance.
/// One credential per IBQ environment / region.
model IbqCredential {
  id         String    @id @default(cuid())
  /// Base URL of the IBQ Odoo instance, e.g. "https://ibraqperfumes.odoo.com"
  baseUrl    String
  /// API key sent as the `x-api-key` header on every request
  apiKey     String
  /// Odoo company_id filter — used in GET /api/pos/order?company_id=…
  companyId  Int?
  active     Boolean   @default(true)
  region     String
  /// Timestamp watermark: next run will fetch orders with date_order >= lastSyncAt
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([region])
  @@index([active])
}

/// Header-level record for each IBQ POS order fetched during backup.
model BackupIbqOrder {
  id             String    @id @default(cuid())
  /// IBQ / Odoo integer order id
  orderId        Int
  /// Human-readable order name, e.g. "Order 00001-001-0001"
  orderName      String?
  /// POS reference string from Odoo
  posReference   String?
  companyId      Int?
  companyName    String?
  branchId       Int?
  branchName     String?
  /// POS configuration id (maps to a terminal / branch)
  posConfigId    Int?
  posConfigName  String?
  dateOrder      DateTime?
  amountTotal    Float?
  amountTax      Float?
  amountPaid     Float?
  /// Odoo order state: draft | paid | done | invoiced | cancel
  state          String?
  partnerId      Int?
  partnerName    String?
  region         String
  /// Full raw JSON payload preserved for debugging / re-processing
  rawJson        Json?
  createdAt      DateTime  @default(now())

  orderLines    BackupIbqOrderLine[]
  orderPayments BackupIbqOrderPayment[]

  @@unique([orderId, region])
  @@index([region])
  @@index([orderId])
  @@index([dateOrder])
  @@index([state])
}

/// Line items belonging to a BackupIbqOrder.
model BackupIbqOrderLine {
  id                String   @id @default(cuid())
  /// Parent IBQ order id (denormalised for fast queries)
  orderId           Int
  /// Odoo integer id of this line record
  lineId            Int?
  productId         Int?
  productName       String?
  qty               Float?
  priceUnit         Float?
  priceSubtotal     Float?
  priceSubtotalIncl Float?
  discount          Float?
  region            String
  createdAt         DateTime @default(now())

  /// FK to parent BackupIbqOrder
  parentOrderId String?
  order         BackupIbqOrder? @relation(fields: [parentOrderId], references: [id])

  @@index([region])
  @@index([orderId])
  @@index([parentOrderId])
}

/// Payment entries belonging to a BackupIbqOrder.
model BackupIbqOrderPayment {
  id            String   @id @default(cuid())
  /// Parent IBQ order id (denormalised for fast queries)
  orderId       Int
  /// Odoo integer id of this payment / statement line
  paymentId     Int?
  /// Payment method name, e.g. "Cash", "Card"
  paymentName   String?
  amount        Float?
  region        String
  createdAt     DateTime @default(now())

  /// FK to parent BackupIbqOrder
  parentOrderId String?
  order         BackupIbqOrder? @relation(fields: [parentOrderId], references: [id])

  @@index([region])
  @@index([orderId])
  @@index([parentOrderId])
}

// ─── Odoo (Main) Backup Tables ────────────────────────────────────────────────

/// Stores API credentials for each Odoo instance (one per region/environment).
/// Enables per-region Odoo fetches without relying solely on env vars.
model OdooCredential {
  id         String    @id @default(cuid())
  /// Base URL of the Odoo instance, e.g. "https://mycompany.odoo.com"
  baseUrl    String
  /// API key sent as the `x-api-key` header on every request
  apiKey     String
  /// Human-readable region identifier, e.g. "AE", "SA", "KW"
  region     String
  active     Boolean   @default(true)
  /// Override the default REST endpoint path used when fetching orders.
  /// Defaults to "/api/pos/order" (Odoo POS REST API) when null.
  /// Set to "/api/sale.order" for Odoo instances that serve sale orders
  /// instead of POS orders, or to any other path required by the instance.
  apiPath               String?
  /// When false, TLS certificate verification is skipped for this credential.
  /// Use only for dev/staging Odoo instances whose hostname does not match
  /// the server certificate (e.g. *.dev.odoo.com vs a *.odoo.com cert).
  /// Always keep true (the default) for production credentials.
  rejectUnauthorizedSsl Boolean   @default(true)
  /// Timestamp watermark: next scheduled run fetches orders after this date
  lastSyncAt            DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([region])
  @@index([active])
}

/// Tracks the last successful sync watermark for the main Odoo backup job.
model OdooBackupState {
  id         String    @id @default(cuid())
  /// Identifies the Odoo source instance — defaults to "default" for the
  /// single primary Odoo instance configured via env vars.
  source     String    @unique @default("default")
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

/// Header-level record for each order fetched from the main Odoo instance during backup.
model BackupOdooOrder {
  id           String    @id @default(cuid())
  /// Odoo integer order id
  orderId      Int       @unique
  /// Human-readable order name / reference, e.g. "S00001" or "Order 00001"
  orderName    String?
  branchId     Int?
  branchName   String?
  dateOrder    DateTime?
  /// Grand total including tax (amount_total)
  amountTotal  Float?
  /// Subtotal excluding tax (amount_untaxed) — maps to TOTAL_PRICE in old integration
  amountUntaxed Float?
  amountTax    Float?
  /// Discount / loyalty amount (amount_discount) — maps to TOTAL_LOYALTY in old integration
  amountDiscount Float?
  /// Odoo order state: draft | sale | done | cancel | paid | posted etc.
  state        String?
  partnerId    Int?
  partnerName  String?
  /// Warehouse id from warehouse_id Many2one field (outlet identifier)
  warehouseId  Int?
  /// Warehouse/outlet name from warehouse_id[1] — maps to OUTLET_NAME in old integration
  warehouseName String?
  /// POS config id from pos_config_id Many2one field (register identifier)
  posConfigId  Int?
  /// POS config/register name from pos_config_id[1] or session_id[1] — maps to REGISTER_NAME in old integration
  posConfigName String?
  /// Customer type derived from order tags or partner type (e.g. NORMAL, HUNGERSTATION, TALABAT)
  customerType String?
  /// Timezone string carried on the order, e.g. "Asia/Dubai"
  timezone     String?
  /// Region identifier (e.g. "AE", "KW") from the OdooCredential that fetched this order.
  /// Populated during per-region credential backup; null when fetched via global env-var path.
  region       String?
  /// Resolved StoreConfiguration.branchCode for this order (looked up by odooBranchId).
  /// Cached here so the processor doesn't need to re-query the store config table.
  resolvedBranchCode String?
  /// Full raw JSON payload preserved for debugging / re-processing
  rawJson      Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orderLines    BackupOdooOrderLine[]
  orderPayments BackupOdooOrderPayment[]

  @@index([orderId])
  @@index([dateOrder])
  @@index([state])
  @@index([region])
}

/// Line items belonging to a BackupOdooOrder.
model BackupOdooOrderLine {
  id                String   @id @default(cuid())
  /// Parent Odoo order id (denormalised for fast queries)
  orderId           Int
  /// Odoo integer id of this line record
  lineId            Int?
  productId         Int?
  productName       String?
  /// Line reference / description (e.g. order name on the line, "CCNTRBHR/280633")
  lineName          String?
  /// Product internal reference / SKU (default_code or product_code or product_barcode) — maps to ITEM_NUMBER in old integration
  productCode       String?
  qty               Float?
  priceUnit         Float?
  priceSubtotal     Float?
  priceSubtotalIncl Float?
  discount          Float?
  /// Tax name / code from tax_id (e.g. "VAT 5%") — maps to TAX_NAME in old integration
  taxName           String?
  createdAt         DateTime @default(now())

  /// FK to parent BackupOdooOrder
  parentOrderId String?
  order         BackupOdooOrder? @relation(fields: [parentOrderId], references: [id])

  @@index([orderId])
  @@index([parentOrderId])
}

/// Payment entries belonging to a BackupOdooOrder.
model BackupOdooOrderPayment {
  id            String    @id @default(cuid())
  /// Parent Odoo order id (denormalised for fast queries)
  orderId       Int
  /// Odoo integer id of this payment / statement line
  paymentId     Int?
  /// Payment method name, e.g. "Cash", "Card" — maps to PAYMENT_TYPE in old integration
  paymentName   String?
  amount        Float?
  /// ISO currency code, e.g. "AED", "SAR" — maps to CURRENCY in old integration
  currency      String?
  /// Payment date — maps to PAYMENT_DATE in old integration
  paymentDate   DateTime?
  createdAt     DateTime  @default(now())

  /// FK to parent BackupOdooOrder
  parentOrderId String?
  order         BackupOdooOrder? @relation(fields: [parentOrderId], references: [id])

  @@index([orderId])
  @@index([parentOrderId])
}

